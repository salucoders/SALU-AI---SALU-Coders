# Gemini API Key (Required for AI features)
# Use VITE_ prefix for frontend access in hosted environments
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Together AI Key (Required for FLUX Image Generation)
TOGETHER_API_KEY=

# ImageKit (Cloud Image Hosting)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# App Configuration
PORT=3000
NODE_ENV=development
